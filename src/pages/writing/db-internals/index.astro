---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Colophon from '../../../components/Colophon.astro';
import { getNotes, SERIES_TITLE, SERIES_PATH, formatPart, formatDate } from '../../../lib/db-internals';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const notes = await getNotes();
---

<BaseLayout title={`${SERIES_TITLE} — Norah Hoang`} description="Notes from learning how databases work underneath: storage, indexing, transactions, recovery.">
  <div class="page">
    <Colophon />

    <main id="main" class="content">

      <section class="section" aria-labelledby="series-heading">
        <div class="section-header">
          <span class="seal" aria-hidden="true"></span>
          <span id="series-heading" class="label">{SERIES_TITLE}</span>
        </div>

        <p class="series-intro">
          Notes from learning how databases work underneath: how pages are laid out on disk, how indexes stay balanced, how transactions and recovery hold together. Written as I go, so expect rough edges.
        </p>

        {notes.length > 0 ? (
          <ul class="compact-list" role="list">
            {notes.map((note) => (
              <li class="compact">
                <h3 class="compact-title"><a href={`${base}${SERIES_PATH}${note.id}/`}>{note.data.title}</a></h3>
                <div class="compact-meta">{formatPart(note.data.part)} · {formatDate(note.data.date)}</div>
                {note.data.description && <p class="compact-description">{note.data.description}</p>}
                {note.data.source && <p class="compact-stack">{note.data.source}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="series-empty">First notes coming soon.</p>
        )}
      </section>

      <a href={`${base}writing/`} class="case-study-back">Back to writing</a>

    </main>
  </div>
</BaseLayout>
