---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Colophon from '../../components/Colophon.astro';
import { getNotes, SERIES_TITLE, SERIES_PATH, formatPart } from '../../lib/db-internals';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const seriesHref = `${base}${SERIES_PATH}`;
// Newest three notes, latest first.
const latestNotes = (await getNotes({ includeDrafts: false })).slice(-3).reverse();
---

<BaseLayout title="Writing — Norah Hoang">
  <div class="page">
    <Colophon />

    <main id="main" class="content">

      <section class="section" aria-labelledby="case-studies-heading">
        <div class="section-header">
          <span class="seal" aria-hidden="true"></span>
          <span id="case-studies-heading" class="label">Case studies</span>
        </div>

        <ul class="compact-list" role="list">
          <li class="compact">
            <h3 class="compact-title"><a href={`${base}writing/qr-payments/`}>In-store QR payments</a></h3>
            <div class="compact-meta">KOMOJU · 2025</div>
            <p class="compact-description">A net-new in-store payment capability. Async coordination across terminal, gateway, and third-party provider, with fail-closed reconciliation.</p>
            <p class="compact-stack"><span class="stack-tag">Ruby on Rails</span> · <span class="stack-tag">REST</span> · <span class="stack-tag">Sidekiq</span> · <span class="stack-tag">MySQL</span> · <span class="stack-tag">Vue.js</span> · <span class="stack-tag">Android (Java)</span></p>
          </li>
          <li class="compact">
            <h3 class="compact-title"><a href={`${base}writing/elasticsearch-migration/`}>Elasticsearch migration</a></h3>
            <div class="compact-meta">KOMOJU · 2024</div>
            <p class="compact-description">Moved payment search off MySQL onto an event-driven Elasticsearch pipeline. Latency and reliability, quietly.</p>
            <p class="compact-stack"><span class="stack-tag">Elasticsearch (Elastic Cloud)</span> · <span class="stack-tag">MySQL</span> · <span class="stack-tag">Sidekiq</span> · <span class="stack-tag">Redis</span> · <span class="stack-tag">Datadog</span> · <span class="stack-tag">Ruby on Rails</span></p>
          </li>
        </ul>
      </section>

      {latestNotes.length > 0 && (
        <section class="section" aria-labelledby="db-internals-heading">
          <div class="section-header">
            <span class="seal" aria-hidden="true"></span>
            <span id="db-internals-heading" class="label">Notes · {SERIES_TITLE}</span>
          </div>

          <p class="series-intro">
            Working notes from learning how databases work underneath. <a href={seriesHref}>All notes</a>
          </p>

          <ul class="compact-list" role="list">
            {latestNotes.map((note) => (
              <li class="compact">
                <h3 class="compact-title"><a href={`${seriesHref}${note.id}/`}>{note.data.title}</a></h3>
                <div class="compact-meta">{formatPart(note.data.part)}</div>
                {note.data.description && <p class="compact-description">{note.data.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <a href={base} class="case-study-back">Back home</a>

    </main>
  </div>
</BaseLayout>
