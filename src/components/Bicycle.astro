---
// Signature illustration: a flower-seller's bicycle in thin lines.
// Wrapped as an accessible link to the résumé (hosted on Google Drive),
// with JS-driven ride animation handled by BaseLayout scripts. The
// bicycle-body, wheels, and flower groups are structured for hover
// animation and delivery ride.
const RESUME_URL = 'https://drive.google.com/file/d/1gdnFQHO_rWKBeJJ9aGSwd2jLopVFxhxj/view?usp=sharing';
---

<a
  class="signature-mark"
  id="bicycleLink"
  href={RESUME_URL}
  target="_blank"
  rel="noopener"
  aria-label="Download résumé (opens in new tab)"
>
  <svg viewBox="0 0 120 76" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" role="presentation" aria-hidden="true">
    <g class="bicycle-body">
      <g class="bicycle-flowers">
        <line x1="82" y1="46" x2="79" y2="18"/>
        <line x1="85" y1="46" x2="86" y2="14"/>
        <line x1="88" y1="46" x2="92" y2="10"/>
        <line x1="91" y1="46" x2="97" y2="15"/>
        <line x1="94" y1="46" x2="102" y2="19"/>
        <line x1="97" y1="46" x2="108" y2="16"/>
        <circle cx="79" cy="18" r="2.2"/>
        <circle cx="86" cy="14" r="2.4"/>
        <circle cx="92" cy="10" r="2.6"/>
        <circle cx="97" cy="15" r="2.3"/>
        <circle cx="102" cy="19" r="2.2"/>
        <circle cx="108" cy="16" r="2.4"/>
      </g>
      <line x1="80" y1="48" x2="100" y2="48"/>
      <line x1="82" y1="48" x2="82" y2="52"/>
      <line x1="98" y1="48" x2="98" y2="52"/>
      <g class="bicycle-wheel wheel-rear" style="transform-origin: 90px 62px;">
        <circle cx="90" cy="62" r="10"/>
        <line x1="90" y1="52" x2="90" y2="72"/>
        <line x1="80" y1="62" x2="100" y2="62"/>
        <line x1="82.93" y1="54.93" x2="97.07" y2="69.07"/>
        <line x1="97.07" y1="54.93" x2="82.93" y2="69.07"/>
      </g>
      <g class="bicycle-wheel wheel-front" style="transform-origin: 30px 62px;">
        <circle cx="30" cy="62" r="10"/>
        <line x1="30" y1="52" x2="30" y2="72"/>
        <line x1="20" y1="62" x2="40" y2="62"/>
        <line x1="22.93" y1="54.93" x2="37.07" y2="69.07"/>
        <line x1="37.07" y1="54.93" x2="22.93" y2="69.07"/>
      </g>
      <line x1="30" y1="62" x2="60" y2="62"/>
      <line x1="60" y1="62" x2="48" y2="42"/>
      <line x1="60" y1="62" x2="72" y2="42"/>
      <line x1="48" y1="42" x2="72" y2="42"/>
      <line x1="72" y1="42" x2="90" y2="62"/>
      <line x1="60" y1="62" x2="60" y2="40"/>
      <line x1="55" y1="40" x2="65" y2="40"/>
      <line x1="48" y1="42" x2="42" y2="34"/>
      <line x1="38" y1="34" x2="46" y2="34"/>
      <line x1="38" y1="40" x2="46" y2="40"/>
      <line x1="38" y1="40" x2="38" y2="46"/>
      <line x1="46" y1="40" x2="46" y2="46"/>
      <line x1="38" y1="46" x2="46" y2="46"/>
    </g>
  </svg>
</a>
